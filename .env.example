# Copy this file to ".env" and fill in your AnyList sign-in.
#
# These are your real AnyList account credentials. The library this app uses is
# an unofficial, reverse-engineered client, and there is no OAuth or API token
# to use instead. They stay on this machine, are never sent to the browser, and
# are never written into data/db.json.
#
# Keep .env out of version control. It is already in .gitignore.

ANYLIST_EMAIL=you@example.com
ANYLIST_PASSWORD=your-anylist-password

# Optional. Defaults to 4321.
# PORT=4321
