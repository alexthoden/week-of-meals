# /etc/weekofmeals/env
#
# Read by systemd (EnvironmentFile), owned root:weekofmeals, mode 0640.
# It holds your AnyList password, so it is deliberately not in the repo and
# deliberately not readable by other users on the box.
#
# systemd parses this file itself: no quotes needed, no shell expansion, and
# a value containing '#' must not be quoted or the quotes become part of it.

# --- where it listens --------------------------------------------------------
# Loopback only. cloudflared connects to this from the same machine; nothing
# outside the VM ever reaches this port.
PORT=4321
HOST=127.0.0.1

# --- where the data lives ----------------------------------------------------
# One directory holding the household registry, one database per household, and
# the photos:
#
#   households.json          who is in which household
#   households/<id>.json     that household's recipes, week, list, settings
#   households/backups/<id>/ its timestamped copies
#   images/<id>/             its photos
#
# DATA_FILE from before households still works — its directory is used as the
# root — so an existing unit file keeps pointing at the same disk. New installs
# should set DATA_ROOT.
DATA_ROOT=/var/lib/weekofmeals

# --- AnyList ----------------------------------------------------------------
# Each household now sets its own AnyList account under Settings in the app, so
# these are no longer read at runtime.
#
# They are still honoured once, when an installation from before households
# first starts up: the account here becomes the migrated household's, encrypted,
# and is never read again. A household created afterwards must supply its own —
# it deliberately does not inherit this one, or the second family's shopping
# list would land in the first family's AnyList.
#
# Safe to delete after the first successful start.
ANYLIST_EMAIL=
ANYLIST_PASSWORD=

# --- encryption at rest ------------------------------------------------------
# Encrypts the AnyList passwords stored in each household's database, so the
# nightly tarball and any off-box copy carry ciphertext.
#
# 64 hex characters. Generate with: openssl rand -hex 32
# Leave blank and one is generated into $DATA_ROOT/secret.key with mode 0600.
# Back it up somewhere other than beside the backups: losing it costs you the
# stored AnyList passwords, which then have to be entered again.
SECRET_KEY=

# --- Cloudflare Access ------------------------------------------------------
# Fill these in after Step 5 of VM-SETUP.md. Until both are set the app does no
# authentication of its own, which is fine while it is only on localhost.
#
# CF_ACCESS_TEAM is your team name from the Zero Trust dashboard: if your login
# page is https://ourhouse.cloudflareaccess.com then this is "ourhouse".
CF_ACCESS_TEAM=
# CF_ACCESS_AUD is the Application Audience tag, copied from the Access
# application's Overview tab. A long hex string.
CF_ACCESS_AUD=

# Optional second allowlist, checked in addition to your Access policy. Leave
# blank to let the Access policy be the single source of truth.
ALLOWED_EMAILS=

# --- Cache purging on deploy (optional) --------------------------------------
# Every Tunnel hostname is proxied through Cloudflare's edge, which caches
# static files (.js, .css, images) by extension regardless of what this server
# sends. Set these and deploy/update.sh purges the cache automatically after
# every successful deploy, so a frontend fix doesn't sit behind a stale copy.
#
# CF_ZONE_ID: dashboard home page for thodenwoodwardwedding.com, right sidebar.
# CF_API_TOKEN: My Profile -> API Tokens -> Create Token -> "Purge Cache" template,
#   scoped to this one zone. Do not reuse your Tunnel or Access credentials here;
#   this token only needs the ability to purge cache, nothing else.
CF_ZONE_ID=
CF_API_TOKEN=

# --- Backups (optional) -----------------------------------------------------
# If set, deploy/backup.sh copies the nightly archive off the box with rclone.
# Create the remote first:  rclone config
# BACKUP_REMOTE=r2:week-of-meals-backups
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=30
